@article{moradi2025cacp,
  abbr        = {Preprint},
  bibtex_show = {true},
  title       = {Enhanced Renewable Energy Forecasting using Context-Aware Conformal Prediction},
  author      = {Moradi, Alireza and Tanneau, Mathieu and Zandehshahvar, Reza and Van Hentenryck, Pascal},
  journal     = {arXiv preprint arXiv:2510.15780},
  note        = {Under review},
  year        = {2025},
  arxiv       = {2510.15780},
  abstract    = {Context-Aware Conformal Prediction (CACP) calibrates renewable energy forecasts with a weighting mechanism that assigns higher weights to historical observations similar to the target forecasting condition. This yields adaptive prediction intervals without access to, or retraining of, the underlying forecasting model. On NREL day-ahead solar forecasts for MISO, ERCOT, and SPP, CACP improves the reliability-efficiency tradeoff at both site and system levels.},
  selected    = {true}
}

