@article{moradi2026coconet,
  abbr        = {Preprint},
  bibtex_show = {true},
  title       = {CoCoNet: Convex Conformal Network for Multi-Dimensional Uncertainty Regions},
  author      = {Moradi, Alireza and Bruys, Thomas and Van Hentenryck, Pascal and Zandehshahvar, Reza},
  journal     = {arXiv preprint arXiv:2610.24246},
  note        = {Under review},
  year        = {2026},
  arxiv       = {2610.24246},
  abstract    = {Conformal prediction (CP) provides distribution-free coverage guarantees under exchangeability, but the efficiency of its prediction regions depends critically on the choice of the conformity score. This is particularly important in multivariate regression, where dependencies across output dimensions induce complex joint uncertainty structures. This paper introduces CoCoNet (Convex Conformal Network) for learning convex conformity scores that induce flexible, data-adaptive prediction regions. CoCoNet learns the score from held-out data by optimizing prediction-region efficiency while enforcing convexity with respect to the residual, and then applies split-conformal calibration to retain finite-sample coverage guarantees.},
  selected    = {true}
}

@article{moradi2026copula,
  abbr        = {Preprint},
  bibtex_show = {true},
  title       = {Copula-Based Aggregation and Context-Aware Conformal Prediction for Reliable Renewable Energy Forecasting},
  author      = {Moradi, Alireza and Tanneau, Mathieu and Zandehshahvar, Reza and Van Hentenryck, Pascal},
  journal     = {arXiv preprint arXiv:2602.02583},
  note        = {Under review},
  year        = {2026},
  arxiv       = {2602.02583},
  abstract    = {System operators often lack fleet-level probabilistic models and instead rely on site-level forecasts produced by heterogeneous third-party providers. This paper presents a framework that integrates copula-based dependence modeling across sites with Context-Aware Conformal Prediction (CACP) to convert site-level probabilistic forecasts into calibrated fleet-level forecasts. Experiments on large-scale solar data from MISO, ERCOT, and SPP show near-nominal coverage and consistently lower Winkler scores than aggregation-based baselines.},
  selected    = {true}
}

